{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.carry_throw_block": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.stone",
            "Texture.dirt",
            "Texture.diamond_block",
            "Texture.crafting_table",
            "Texture.chest",
            "Texture.mob_spawner",
            "Texture.torch",
            "Texture.barrel",
            "Texture.obsidian",
            "Texture.glass",
            "Texture.glass_pane",
            "Texture.crying_obsidian",
            "Texture.grass_block",
            "Texture.lit_furnace",
            "Texture.furnace",
            "Texture.lit_blast_furnace",
            "Texture.blast_furnace",
            "Texture.bookshelf",
            "Texture.anvil",
            "Texture.enchanting_table"
          ]
        }
      },
      "geometry": "query.variant == 18 ? Geometry.anvil : (query.variant == 19 ? Geometry.enchanting_table : Geometry.default)",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.variant]"
      ]
    }
  }
}